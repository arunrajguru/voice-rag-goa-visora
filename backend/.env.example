# ==================================================
# HH Goa 2026 Task 2: Voice-Enabled RAG Environment Config
# ==================================================

# 1. Speech-to-Text Secrets (Sarvam AI)
SARVAM_API_KEY=your_sarvam_api_key_here

# 2. LLM Provider Adapter (Options: groq, openai, sarvam, mock)
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# 3. Vector & Retrieval Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=10
FINAL_K=3

# 4. Hybrid Weights & Thresholds
DENSE_WEIGHT=0.6
BM25_WEIGHT=0.4
SIMILARITY_THRESHOLD=0.25
GROUNDING_THRESHOLD=0.40

# 5. Server Ports
PORT=8000
FRONTEND_URL=http://localhost:5173
